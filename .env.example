# Apple Music — "Recently Played" on the home page.
# Create a MusicKit key in the Apple Developer portal (Certificates,
# Identifiers & Profiles → Keys → MusicKit) to get the private key,
# key ID, and team ID. The user token is minted by authorizing your
# Apple Music account with MusicKit JS (one-time).
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_MUSIC_KEY_ID=""
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_USER_TOKEN=""

# Optional — shows a "Text me" row on the /card business-card page.
PHONE_NUMBER=""
